{
  "name": "creator-pipeline",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:setup": "node scripts/prepare-db.mjs && prisma migrate deploy && node scripts/seed.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/workflow.test.mjs",
    "worker": "node --experimental-strip-types scripts/worker.mjs",
    "db:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.8.0",
    "@prisma/client": "7.8.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "type": "module"
}
