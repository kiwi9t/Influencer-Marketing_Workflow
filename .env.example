DATABASE_URL="file:./prisma/pipeline.db"

# Email preview writes to the Automation panel. Set send to enable Resend.
EMAIL_MODE="preview"
# EMAIL_FROM="Brand Partnerships <partnerships@example.org>"
# OPS_EMAIL="fulfillment@example.org"
# RESEND_API_KEY=""

# Optional creator submission link. Use a random secret of 32+ characters.
# CREATOR_SUBMISSION_SECRET=""
# CREATOR_SUBMISSION_URL="https://creator-updates.example.org"

# Optional metrics adapter. The endpoint returns four daily totals.
# METRICS_PROVIDER_URL="https://metrics.example.org/relay/daily"
# METRICS_PROVIDER_TOKEN=""
